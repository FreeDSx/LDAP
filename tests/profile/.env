OPENLDAP_VERSION=2.7.2
# OpenLDAP is built on Ubuntu, and another release can rename the runtime library packages in openldap.Dockerfile.
UBUNTU_VERSION=24.04
# The SHA3-512 published as openldap-<version>.sha3-512 beside the release tarball on openldap.org.
OPENLDAP_SHA3_512=8c2cc5efae2d92de864da84d187ba884ae480881451e2030b9b8152635725b2ed011e5bf5dadda89c15266be4758f507f2ae6dc32a222700b31fc342573f45a5
# 389DS is installed from Fedora packages, so a newer DS_VERSION can require a newer FEDORA_VERSION.
FEDORA_VERSION=45
DS_VERSION=3.3.1
OPENDJ_VERSION=5.2.0
