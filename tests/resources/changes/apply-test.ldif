version: 1

# Modify alice: replace sn
dn: cn=alice,dc=foo,dc=bar
changetype: modify
replace: sn
sn: Renamed
-

# Delete bob
dn: cn=bob,dc=foo,dc=bar
changetype: delete

# Add a new entry that will then be renamed below
dn: cn=carol,dc=foo,dc=bar
changetype: add
objectClass: inetOrgPerson
cn: carol
sn: Coder

# Rename carol -> carolyn
dn: cn=carol,dc=foo,dc=bar
changetype: modrdn
newrdn: cn=carolyn
deleteoldrdn: 1

# Spells two descriptions with differing case. RFC 4512 2.5 makes them one attribute, and the entry is
# refused as a duplicate if they are grouped separately.
dn: cn=dave,dc=foo,dc=bar
changetype: add
objectclass: inetOrgPerson
cn: dave
sn: Davis
description: first
DESCRIPTION: second

# A subtree the record below removes whole, which only works if the control is honored on replay.
dn: ou=team,dc=foo,dc=bar
changetype: add
objectClass: organizationalUnit
ou: team

dn: cn=erin,ou=team,dc=foo,dc=bar
changetype: add
objectClass: inetOrgPerson
cn: erin
sn: Engels

dn: ou=team,dc=foo,dc=bar
control: 1.2.840.113556.1.4.805 true
changetype: delete
