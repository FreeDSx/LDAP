version: 1

# Fixed seed for the ldap-server harness under --sasl. Passwords stay cleartext, since the SASL
# mechanisms need the original value rather than a hash.

# Domain root
dn: dc=foo,dc=bar
objectClass: domain
dc: foo

dn: cn=user,dc=foo,dc=bar
objectClass: inetOrgPerson
cn: user
sn: User
uid: user
userPassword: 12345

dn: cn=other,dc=foo,dc=bar
objectClass: inetOrgPerson
cn: other
sn: Other
uid: other
userPassword: secret

# Hashed on purpose ({SHA} of "hashedpass"): mechanisms keying on the stored value must refuse it outright
# rather than treat the hash as the shared secret.
dn: cn=hashed,dc=foo,dc=bar
objectClass: inetOrgPerson
cn: hashed
sn: Hashed
uid: hashed
userPassword: {SHA}JDjNt4ihTaLvLHpHhEFSdZmM1KM=
