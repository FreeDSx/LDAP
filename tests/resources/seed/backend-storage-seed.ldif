version: 1

# Fixed seed for the ldap-backend-storage harness. The --seed-entries entries are generated in the
# command itself, since their count is a run-time option.

# Domain root
dn: dc=foo,dc=bar
objectClass: domain
dc: foo

# Bind identity for suites that do not need to write. Its seeAlso, telephoneNumber and x121Address spell the
# same values cn=admin does, but decorated, so a search proves the rule was applied rather than the spelling.
dn: cn=user,dc=foo,dc=bar
objectClass: inetOrgPerson
cn: user
sn: Admin
userPassword: {SHA}jLIjfQZ5yojbZGTqxg2pY0VROWQ=
seeAlso: CN=Admin, DC=Foo, DC=Bar
telephoneNumber: +1 408 555 1212
x121Address: 1111 2222

# Administrator, a member of the group the harness configures via setAdministrators()
dn: cn=admin,dc=foo,dc=bar
objectClass: inetOrgPerson
cn: admin
sn: Admin
userPassword: {SHA}jLIjfQZ5yojbZGTqxg2pY0VROWQ=
seeAlso: cn=admin,dc=foo,dc=bar
telephoneNumber: +1-408-555-1212
x121Address: 11112222

dn: cn=admins,dc=foo,dc=bar
objectClass: groupOfNames
cn: admins
member: cn=admin,dc=foo,dc=bar

dn: ou=people,dc=foo,dc=bar
objectClass: organizationalUnit
ou: people

dn: cn=alice,ou=people,dc=foo,dc=bar
objectClass: inetOrgPerson
objectClass: extensibleObject
cn: alice
sn: Smith
mail: alice@foo.bar
# Only reachable through its base type, so it shows whether attribute options are honored.
mail;lang-en: alice-en@foo.bar
uidNumber: 99
employeeNumber: A1b2C3
# Matched case-exactly by the schema, so searches on it prove the configured schema is in play.
labeledURI: A1b2C3
# Case folding maps the sharp s to "ss", which lowercasing alone would not.
displayName: Straße
# Decorated spelling of the identifier cn=Smith\, John holds canonically, for the uniqueMember rule.
uniqueMember: CN=Admin, DC=Foo, DC=Bar
# roleOccupant names no rule of its own, so it shows whether the supertype's is inherited.
roleOccupant: CN=Admin, DC=Foo, DC=Bar

dn: cn=nosn,dc=foo,dc=bar
objectClass: groupOfNames
cn: nosn
member: cn=user,dc=foo,dc=bar

# The RDN needs escaping, so it shows whether a DN assertion compares the value or its escaped spelling. Its
# uidNumber sorts below alice's textually and above it numerically, so ordering shows which rule was applied.
dn: cn=Smith\, John,dc=foo,dc=bar
objectClass: groupOfNames
objectClass: extensibleObject
cn: Smith, John
member: cn=user,dc=foo,dc=bar
uidNumber: 100
uniqueMember: cn=admin,dc=foo,dc=bar
roleOccupant: cn=admin,dc=foo,dc=bar
