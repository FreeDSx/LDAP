attributeTypes: ( 1.3.6.1.4.1.1466.101.120.6 NAME 'altServer' DESC 'URIs of other servers replicating the same information' SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 USAGE dSAOperation )
attributeTypes: ( 1.3.6.1.4.1.1466.101.120.5 NAME 'namingContexts' DESC 'naming contexts the server masters or shadows' SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 USAGE dSAOperation )
attributeTypes: ( 1.3.6.1.4.1.1466.101.120.13 NAME 'supportedControl' DESC 'request controls the server recognizes' SYNTAX 1.3.6.1.4.1.1466.115.121.1.38 USAGE dSAOperation )
attributeTypes: ( 1.3.6.1.4.1.1466.101.120.7 NAME 'supportedExtension' DESC 'extended operations the server recognizes' SYNTAX 1.3.6.1.4.1.1466.115.121.1.38 USAGE dSAOperation )
attributeTypes: ( 1.3.6.1.4.1.4203.1.3.5 NAME 'supportedFeatures' DESC 'elective features the server supports' EQUALITY 2.5.13.0 SYNTAX 1.3.6.1.4.1.1466.115.121.1.38 USAGE dSAOperation )
attributeTypes: ( 1.3.6.1.4.1.1466.101.120.15 NAME 'supportedLDAPVersion' DESC 'LDAP versions the server implements' SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 USAGE dSAOperation )
attributeTypes: ( 1.3.6.1.4.1.1466.101.120.14 NAME 'supportedSASLMechanisms' DESC 'SASL mechanisms the server recognizes' SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 USAGE dSAOperation )
attributeTypes: ( 1.3.6.1.1.4 NAME 'vendorName' DESC 'name of the server implementor' EQUALITY 1.3.6.1.4.1.1466.109.114.1 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE NO-USER-MODIFICATION USAGE dSAOperation )
attributeTypes: ( 1.3.6.1.1.5 NAME 'vendorVersion' DESC 'version of the server implementation' EQUALITY 1.3.6.1.4.1.1466.109.114.1 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE NO-USER-MODIFICATION USAGE dSAOperation )
objectClasses: ( 2.5.6.0 NAME 'top' DESC 'top of the class hierarchy' ABSTRACT MUST objectClass )
objectClasses: ( 2.5.6.1 NAME 'alias' DESC 'an alias entry pointing at another entry' SUP 2.5.6.0 STRUCTURAL MUST aliasedObjectName )
objectClasses: ( 2.5.6.6 NAME 'person' DESC 'natural persons' SUP 2.5.6.0 STRUCTURAL MUST ( sn $ cn ) MAY ( userPassword $ telephoneNumber $ seeAlso $ description ) )
objectClasses: ( 2.5.6.7 NAME 'organizationalPerson' DESC 'people associated with an organization' SUP 2.5.6.6 STRUCTURAL MAY ( title $ x121Address $ registeredAddress $ destinationIndicator $ preferredDeliveryMethod $ telexNumber $ teletexTerminalIdentifier $ telephoneNumber $ internationalISDNNumber $ facsimileTelephoneNumber $ street $ postOfficeBox $ postalCode $ postalAddress $ physicalDeliveryOfficeName $ ou $ st $ l $ c ) )
objectClasses: ( 2.16.840.1.113730.3.2.2 NAME 'inetOrgPerson' DESC 'internet-enabled person (RFC 2798)' SUP 2.5.6.7 STRUCTURAL MAY ( uid $ mail $ givenName $ initials $ displayName $ employeeNumber $ memberOf $ labeledURI $ jpegPhoto $ description ) )
objectClasses: ( 2.5.6.9 NAME 'groupOfNames' DESC 'group whose members are distinguished names' SUP 2.5.6.0 STRUCTURAL MUST ( member $ cn ) MAY ( businessCategory $ seeAlso $ owner $ ou $ o $ description ) )
objectClasses: ( 2.5.6.17 NAME 'groupOfUniqueNames' DESC 'group whose members are unique distinguished names' SUP 2.5.6.0 STRUCTURAL MUST ( uniqueMember $ cn ) MAY ( businessCategory $ seeAlso $ owner $ ou $ o $ description ) )
objectClasses: ( 2.5.6.5 NAME 'organizationalUnit' DESC 'organizational units' SUP 2.5.6.0 STRUCTURAL MUST ou MAY ( businessCategory $ description $ destinationIndicator $ facsimileTelephoneNumber $ internationalISDNNumber $ l $ physicalDeliveryOfficeName $ postalAddress $ postalCode $ postOfficeBox $ preferredDeliveryMethod $ registeredAddress $ searchGuide $ seeAlso $ st $ street $ telephoneNumber $ teletexTerminalIdentifier $ telexNumber $ userPassword $ x121Address ) )
objectClasses: ( 2.5.6.4 NAME 'organization' DESC 'organizations' SUP 2.5.6.0 STRUCTURAL MUST o MAY ( userPassword $ searchGuide $ seeAlso $ businessCategory $ x121Address $ registeredAddress $ destinationIndicator $ preferredDeliveryMethod $ telexNumber $ teletexTerminalIdentifier $ telephoneNumber $ internationalISDNNumber $ facsimileTelephoneNumber $ street $ postOfficeBox $ postalCode $ postalAddress $ physicalDeliveryOfficeName $ st $ l $ description $ c ) )
objectClasses: ( 0.9.2342.19200300.100.4.13 NAME 'domain' DESC 'DNS domains' SUP 2.5.6.0 STRUCTURAL MUST dc MAY ( o $ description $ l $ st $ c ) )
objectClasses: ( 2.5.6.14 NAME 'device' DESC 'devices, and the conventional structural carrier for auxiliary classes such as pwdPolicy' SUP 2.5.6.0 STRUCTURAL MUST cn MAY ( serialNumber $ seeAlso $ owner $ ou $ o $ l $ description ) )
objectClasses: ( 1.3.6.1.4.1.1466.344 NAME 'dcObject' DESC 'auxiliary class for domain component' SUP 2.5.6.0 AUXILIARY MUST dc )
objectClasses: ( 2.5.20.1 NAME 'subschema' DESC 'server subschema entry' SUP 2.5.6.0 AUXILIARY MAY ( dITStructureRules $ nameForms $ dITContentRules $ objectClasses $ attributeTypes $ matchingRules $ matchingRuleUse ) )
objectClasses: ( 1.3.6.1.4.1.1466.101.120.111 NAME 'extensibleObject' DESC 'any attribute type allowed' SUP 2.5.6.0 AUXILIARY )
objectClasses: ( 2.5.17.0 NAME 'subentry' DESC 'entry holding administrative information for part of a subtree' SUP 2.5.6.0 STRUCTURAL MUST ( cn $ subtreeSpecification ) )
objectClasses: ( 2.5.6.8 NAME 'organizationalRole' DESC 'a position within an organization' SUP 2.5.6.0 STRUCTURAL MUST cn MAY ( x121Address $ registeredAddress $ destinationIndicator $ preferredDeliveryMethod $ telexNumber $ teletexTerminalIdentifier $ telephoneNumber $ internationalISDNNumber $ facsimileTelephoneNumber $ seeAlso $ roleOccupant $ street $ postOfficeBox $ postalCode $ postalAddress $ physicalDeliveryOfficeName $ ou $ st $ l $ description ) )
objectClasses: ( 2.5.6.11 NAME 'applicationProcess' DESC 'an application process' SUP 2.5.6.0 STRUCTURAL MUST cn MAY ( seeAlso $ ou $ l $ description ) )
objectClasses: ( 2.5.6.2 NAME 'country' DESC 'a country' SUP 2.5.6.0 STRUCTURAL MUST c MAY ( searchGuide $ description ) )
objectClasses: ( 2.5.6.3 NAME 'locality' DESC 'a geographic area' SUP 2.5.6.0 STRUCTURAL MAY ( street $ seeAlso $ searchGuide $ st $ l $ description ) )
objectClasses: ( 2.5.6.10 NAME 'residentialPerson' DESC 'a person and their residence' SUP 2.5.6.6 STRUCTURAL MUST l MAY ( businessCategory $ x121Address $ registeredAddress $ destinationIndicator $ preferredDeliveryMethod $ telexNumber $ teletexTerminalIdentifier $ telephoneNumber $ internationalISDNNumber $ facsimileTelephoneNumber $ street $ postOfficeBox $ postalCode $ postalAddress $ physicalDeliveryOfficeName $ st ) )
objectClasses: ( 1.3.6.1.1.3.1 NAME 'uidObject' DESC 'adds a uid to an entry' SUP 2.5.6.0 AUXILIARY MUST uid )
